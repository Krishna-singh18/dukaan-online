# ========================================================
# DUKAAN ONLINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your store details:
# cp .env.example .env
# ========================================================

# 1. Supabase Cloud Database & Authentication
# Find these in Supabase Dashboard -> Project Settings -> API Keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# 2. Store Identity
VITE_STORE_NAME=My Kirana Store
VITE_STORE_OWNER=Store Owner

# 3. Contact & WhatsApp Ordering
# Note: WhatsApp number with country code '91', without '+' or spaces (e.g. 919876543210)
VITE_STORE_WHATSAPP=919876543210
VITE_STORE_PHONE=+91 98765 43210
VITE_STORE_EMAIL=store@example.com

# 4. Store Location
VITE_STORE_AREA=Central Market
VITE_STORE_CITY=Your City
